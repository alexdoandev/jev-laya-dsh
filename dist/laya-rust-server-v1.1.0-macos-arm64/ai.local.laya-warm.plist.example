<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Template: install via the sed command in RUN.md (replaces __BINARY__ /
     __MODEL_DIR__ / __DYLIB__). KeepAlive relaunches the server if it ever exits;
     weights still unload on idle / memory pressure per the env below. -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>ai.local.laya-warm</string>
    <key>ProgramArguments</key>
    <array>
        <string>__BINARY__</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>10</integer>
    <key>StandardOutPath</key>
    <string>/tmp/laya-rust.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/laya-rust.log</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>LAYA_PORT</key>
        <string>8755</string>
        <key>LAYA_MODEL_DIR</key>
        <string>__MODEL_DIR__</string>
        <key>ORT_DYLIB_PATH</key>
        <string>__DYLIB__</string>
        <key>LAYA_IDLE_UNLOAD_SECS</key>
        <string>1800</string>
        <key>LAYA_THREADS</key>
        <string>4</string>
    </dict>
</dict>
</plist>
